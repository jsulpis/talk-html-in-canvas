{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "setup/**/*.ts",
    "components/**/*.vue",
    "layouts/**/*.vue",
    // Slidev's own augmentation of `$frontmatter`, `$slidev`, `$page`...
    "node_modules/@slidev/client/shim-vue.d.ts"
  ]
}
